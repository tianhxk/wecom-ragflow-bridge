# ============================================
# 企业微信智能机器人 <-> RAGFLOW 桥接服务 配置
# ============================================
# 复制此文件为 .env 并填入实际值：cp .env.example .env

# ---------- 企业微信配置 ----------
# 在企业微信管理后台 -> 应用管理 -> 智能机器人 -> 开启API模式 -> 选择"长连接"
# 获取 BotID 和 Secret
WECOM_BOT_ENABLED=true
WECOM_BOT_ID=aibibFLxD74QizFVt8Fvs34lixF-D7uO8Vc
WECOM_SECRET=ItFzdzZATOlxshUuterRY5iyv6eDiwiBAEqPcwgf4vs
# 在企业微信管理后台 -> 企业管理 -> 基础信息 -> 企业ID
WECOM_CORP_ID=wwfb737b30982ab292
# ---------- RAGFLOW 配置 ----------
#CHAT_PROVIDER=ragflow
# RAGFLOW API 地址（因为桥接服务和 RAGFLOW 在同一 Docker 网络，可用内部地址）
RAGFLOW_API_BASE=http://192.168.1.212/

# RAGFLOW 应用的 API Key（在 RAGFLOW 控制台 -> 你的应用 -> API 访问 中获取）
RAGFLOW_API_KEY=ragflow-CazklDyMsBQcEu-VMsanOqPSl_KZD71IL6Hick1kx7U

# RAGFLOW 应用的 API Key（在 RAGFLOW 控制台 -> agent应用 -> 具体的智能体-右上角-管理-嵌入网站中获得 访问 中获取）
RAGFLOW_AGENT_ID=456d17c026ac11f1a9876f7f200b1a45

CHAT_PROVIDER=dify
# ---------- Dify 配置 ----------
# Dify API 地址，一般为 http://你的Dify地址/v1 或 https://api.dify.ai/v1
DIFY_API_BASE=http://192.168.1.212:8081/v1

# Dify 应用 API Key
DIFY_API_KEY=app-e1cTsHN5Pm6Ak2AAK2L0AXTn
# MinerU API 地址（用于图片 OCR 识别）
MINERU_API_BASE=https://mineru.net

MINERU_API_KEY=eyJ0eXBlIjoiSldUIiwiYWxnIjoiSFM1MTIifQ.eyJqdGkiOiI5NzYwMDUxMiIsInJvbCI6IlJPTEVfUkVHSVNURVIiLCJpc3MiOiJPcGVuWExhYiIsImlhdCI6MTc3NDUxMjg4MSwiY2xpZW50SWQiOiJsa3pkeDU3bnZ5MjJqa3BxOXgydyIsInBob25lIjoiIiwib3BlbklkIjpudWxsLCJ1dWlkIjoiYWVlNGZmNzktMjM5Zi00ZDk5LTk2MmItNDI5NmViODY2MDgzIiwiZW1haWwiOiIiLCJleHAiOjE3ODIyODg4ODF9.Jj24JkytmXBlbto_FHUhdD2YqbXv8KjMHcqs5TRCslPOxJ-mEI5t_PeaVx3iLprDd9Klg-GwC2XqbWqXsniS3g

# ============================================
# 企业微信智能机器人 <-> RAGFLOW 桥接服务 配置
# ============================================
# 复制此文件为 .env 并填入实际值：cp .env.example .env

# ---------- 企业微信配置 ----------
# 在企业微信管理后台 -> 应用管理 -> 智能机器人 -> 开启API模式 -> 选择"长连接"
# 获取 BotID 和 Secret
WECOM_BOT_ID=你的BotID
WECOM_SECRET=你的Secret
WECOM_BOT_ENABLED=true

# 企业 ID（用于图片识别等 API 调用）
# 在企业微信管理后台 -> 我的企业 -> 企业信息 -> 企业 ID
WECOM_CORP_ID=你的CorpID

# ---------- 微信客服配置 ----------
# 开启后会启动 webhook 服务，企业微信后台需要把 API 接收消息 URL 配到:
# https://你的域名/wechat-kf/callback
WECOM_KF_ENABLED=false
WECOM_KF_SECRET=你的微信客服Secret
WECOM_KF_CALLBACK_TOKEN=你的微信客服回调Token
WECOM_KF_ENCODING_AES_KEY=你的微信客服回调EncodingAESKey
WECOM_KF_OPEN_KFID=
WECOM_KF_WEBHOOK_HOST=0.0.0.0
WECOM_KF_WEBHOOK_PORT=8080
WECOM_KF_WEBHOOK_PATH=/wechat-kf/callback
WECOM_KF_MAX_TEXT_MESSAGE_BYTES=1500

# ---------- 聊天后端配置 ----------
# 可选值：ragflow / dify
CHAT_PROVIDER=ragflow

# ---------- RAGFLOW 配置 ----------
# RAGFLOW API 地址（因为桥接服务和 RAGFLOW 在同一 Docker 网络，可用内部地址,只需要写域名）
RAGFLOW_API_BASE=http://nginx/

# RAGFLOW 应用的 API Key（在 RAGFLOW 控制台 -> 你的应用 -> API 访问 中获取）
RAGFLOW_API_KEY=你的APIKey

# RAGFLOW 应用的 API Key（在 RAGFLOW 控制台 -> agent应用 -> 具体的智能体-右上角-管理-嵌入网站中获得 访问 中获取）
RAGFLOW_AGENT_ID=你的AgentID

# ---------- Dify 配置 ----------
# Dify API 地址，一般为 http://你的Dify地址/v1 或 https://api.dify.ai/v1
DIFY_API_BASE=http://dify-api/v1

# Dify 应用 API Key
DIFY_API_KEY=你的DifyAPIKey

# ---------- MinerU OCR 配置 ----------
# MinerU API 地址（用于图片 OCR 识别）
MINERU_API_BASE=https://mineru.net
# MinerU API Key
MINERU_API_KEY=你的APIKey

# MinerU OCR 识别方式：V1parse V4batch
# V1parse:  Agent 轻量解析 API，适合单张图片，但是会限流,已支持
# V4batch: 使用 v4/batch 接口解析,精准解析 API,需要token,待测试
MINERU_OCR_METHOD=V1parse
#企业微信媒体文件保存目录
MEDIA_DIR=./config/media
# ---------- 可选配置 ----------
# 是否启用流式回复（推荐开启，打字机效果）
STREAM_MODE=true

# 心跳间隔（秒）
HEARTBEAT_INTERVAL=30

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

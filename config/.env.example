# ============================================
# WeCom RAGFLOW Bridge 配置示例
# 复制到 config/.env 或 Docker 挂载目录中的 .env 后再填写真实值。
# ============================================

# ---------- 通道开关 ----------
# 至少开启一个通道：企业微信智能机器人、微信客服、WorkBot 或企业微信会话存档。
WECOM_BOT_ENABLED=true
WECOM_KF_ENABLED=false
WORKBOT_ENABLED=false
WECOM_ARCHIVE_ENABLED=false

# ---------- 企业微信基础配置 ----------
# 企业微信管理后台 -> 我的企业 -> 企业信息。
WECOM_CORP_ID=your_corp_id

# 企业微信管理后台 -> 应用管理 -> 智能机器人 -> API 模式。
# 仅 WECOM_BOT_ENABLED=true 时必填。
WECOM_BOT_ID=your_bot_id
WECOM_SECRET=your_secret

# ---------- Webhook 监听 ----------
# 微信客服、WorkBot、会话存档可以共用同一个端口，但路径必须不同。
WEBHOOK_PORT=8090

# ---------- 微信客服 ----------
# 仅 WECOM_KF_ENABLED=true 时必填。
# 公网回调地址示例：https://example.com/wechat-kf/callback
WECOM_KF_SECRET=your_wechat_kf_secret
WECOM_KF_CALLBACK_TOKEN=your_wechat_kf_callback_token
WECOM_KF_ENCODING_AES_KEY=your_wechat_kf_encoding_aes_key
WECOM_KF_OPEN_KFID=

# ---------- 企业微信会话存档 ----------
# 仅 WECOM_ARCHIVE_ENABLED=true 时必填。
# 需要下载企业微信官方 WeWorkFinanceSdk 动态库，并挂载到容器内。
WECOM_ARCHIVE_SECRET=your_msgaudit_secret
WECOM_ARCHIVE_PRIVATE_KEY_PATH=/opt/app/config/wecom_archive_private_key.pem
# 如果企业微信后台配置了多个公钥版本，可按 publickey_ver 映射私钥文件。
# WECOM_ARCHIVE_PRIVATE_KEY_MAP=1=/opt/app/config/key_v1.pem;2=/opt/app/config/key_v2.pem
WECOM_ARCHIVE_SDK_PATH=/opt/app/config/libWeWorkFinanceSdk_C.so
# WECOM_ARCHIVE_START_SEQ=0
# WECOM_ARCHIVE_POLL_INTERVAL=5
# WECOM_ARCHIVE_LIMIT=1000
# WECOM_ARCHIVE_TIMEOUT=10
# WECOM_ARCHIVE_CURSOR_KEY=default
# WECOM_ARCHIVE_WEBHOOK_HOST=0.0.0.0
# WECOM_ARCHIVE_WEBHOOK_PORT=8090
# WECOM_ARCHIVE_WEBHOOK_PATH=/wecom/archive/callback
# 企业微信后台回调配置中的 Token 和 EncodingAESKey。
# WECOM_ARCHIVE_CALLBACK_TOKEN=
# WECOM_ARCHIVE_ENCODING_AES_KEY=
# WECOM_ARCHIVE_POLL_ENABLED=true
# WECOM_ARCHIVE_PROXY=
# WECOM_ARCHIVE_PROXY_PASSWORD=

# ---------- WorkBot ----------
# 公网回调地址示例：https://example.com/workbot/callback
WORKBOT_ROBOT_IDS=robot_id_1,robot_id_2
WORKBOT_CALLBACK_URLS=robot_id_1=https://example.com/workbot/callback/{botid};robot_id_2=https://example.com/workbot/callback/{botid}
WORKBOT_BOT_NICKNAMES=robot_id_1=机器人1昵称;robot_id_2=机器人2昵称

# 只读查询 API。为空时不启用。
# 客户端请求需使用 Authorization: Bearer <token>。
WORKBOT_QUERY_API_TOKEN=
# WORKBOT_QUERY_API_PATH=/api/workbot
# WORKBOT_QUERY_MAX_RANGE_DAYS=31

# ---------- MySQL ----------
# WorkBot 消息和会话存档消息都会写入该数据库，库和表会自动创建。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=infini_rag_flow
MYSQL_DBNAME=workbot

# ---------- 聊天后端 ----------
# 支持 ragflow / dify。
CHAT_PROVIDER=ragflow

# CHAT_PROVIDER=ragflow 时必填。
RAGFLOW_API_BASE=http://nginx/
RAGFLOW_API_KEY=your_ragflow_api_key
RAGFLOW_AGENT_ID=your_agent_id

# CHAT_PROVIDER=dify 时必填。
DIFY_API_BASE=http://dify-api/v1
DIFY_API_KEY=your_dify_api_key

# ---------- 可选 OCR ----------
# 留空则禁用图片 OCR。
MINERU_API_KEY=

# ---------- 通用运行配置 ----------
STREAM_MODE=true
LOG_LEVEL=INFO
# LOG_FILE=logs/wecom-ragflow-bridge.log
# LOG_RETENTION_DAYS=30

# ============================================
# 高级配置：通常保持默认即可。
# ============================================

# 企业微信智能机器人 WebSocket 地址。
# WECOM_WS_URL=wss://openws.work.weixin.qq.com

# WebSocket 心跳间隔，单位秒。
# HEARTBEAT_INTERVAL=30

# 微信客服 webhook 默认值。
# WECOM_KF_WEBHOOK_HOST=0.0.0.0
# WECOM_KF_WEBHOOK_PATH=/wechat-kf/callback
# WECOM_KF_WEBHOOK_PORT=8090
# WECOM_KF_MAX_TEXT_MESSAGE_BYTES=1500
# WECOM_KF_STATE_FILE=./config/wechat_kf_state.json

# WorkBot API 和 webhook 默认值。
# WORKBOT_BASE_URL=https://flowbot.feiliu.run
# WORKBOT_WEBHOOK_HOST=0.0.0.0
# WORKBOT_WEBHOOK_PATH=/workbot/callback
# WORKBOT_WEBHOOK_PORT=8090
# WORKBOT_MAX_TEXT_MESSAGE_BYTES=3500

# WorkBot 消息队列和并发 worker。
# WORKBOT_MESSAGE_WORKERS=4
# WORKBOT_MESSAGE_QUEUE_SIZE=1000
# WORKBOT_MESSAGE_RECOVER_LIMIT=1000
# WORKBOT_MESSAGE_DRAIN_TIMEOUT=10

# WorkBot 昵称自动刷新间隔，单位秒。
# WORKBOT_BOT_NICKNAME_REFRESH_INTERVAL=3600

# WorkBot 回调健康检查。
# WORKBOT_HEALTH_CHECK_ENABLED=true
# WORKBOT_HEALTH_CHECK_INTERVAL=60
# WORKBOT_HEALTH_CHECK_TIMEOUT=5
# WORKBOT_HEALTH_CHECK_FAILURES=3
# WORKBOT_HEALTH_CHECK_URL=

# MinerU OCR 默认值。
# MINERU_API_BASE=https://mineru.net
# MINERU_OCR_METHOD=file

# 媒体文件保存目录。
# MEDIA_DIR=./config/media